# 2.5. Скачивание датасета (Wikipedia streaming + tokenization в DataSphere)
print("Downloading Wikipedia RU dataset...")
from datasets import load_dataset
import re

wiki = load_dataset("wikimedia/wikipedia", "20231101.ru", split="train", streaming=True)

# Tokenize on the fly, save to npy
all_ids = []
count = 0
for item in wiki:
    text = item.get("text", "")
    text = re.sub(r'[^а-яА-ЯёЁ\s.,;:!?\-\—«»()""]', '', text)
    text = re.sub(r'\s+', ' ', text).strip()
    if len(text) < 20:
        continue
    ids = char_vocab.encode(text)
    ids.append(0)  # separator
    all_ids.extend(ids)
    count += 1
    if count % 50000 == 0:
        print(f"  {count:,} articles, {len(all_ids)/1e6:.1f}M tokens")
    if len(all_ids) > 100_000_000:  # 100M tokens ~ 400 MB
        break

all_ids = np.array(all_ids, dtype=np.int32)
print(f"Dataset: {len(all_ids)/1e6:.1f}M tokens from {count:,} articles")
